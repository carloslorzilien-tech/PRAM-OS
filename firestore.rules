rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // FUNCIONES AUXILIARES DE SEGURIDAD & AUTENTICACIÓN
    // ==============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPreApprovedEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'carlos.lorzilien@gmail.com' ||
        request.auth.token.email == 'carlosomarlorzilienservilien@gmail.com' ||
        request.auth.token.email == 'carlosmarlorzilienservilien@gmail.com'
      );
    }

    function isDirector() {
      return isAuthenticated() && (
        request.auth.token.email == 'carlos.lorzilien@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['DIRECTOR', 'AREA_DIRECTOR'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('rol', '') in ['DIRECTOR', 'AREA_DIRECTOR']) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'APPROVED')
      );
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        isPreApprovedEmail() ||
        isDirector() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'APPROVED')
      );
    }

    // ==============================================================
    // 1. COLECCIÓN 'users' (Perfiles de Directores, Mentores y Alumnos)
    // ==============================================================
    match /users/{userId} {
      // Cada usuario lee su propio perfil; los directores leen todos para auditoría
      allow read: if isOwner(userId) || isDirector();

      // Registro inicial del perfil al iniciar sesión
      allow create: if isOwner(userId);

      // El usuario puede actualizar su información básica sin elevar privilegios
      // El director puede actualizar rol y status para aprobar o rechazar solicitudes
      allow update: if isDirector() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'role', 'status'])
      );

      allow delete: if isDirector();
    }

    // ==============================================================
    // 2. COLECCIÓN 'sessions' (Tutorías y Horas Pedagógicas)
    // ==============================================================
    match /sessions/{sessionId} {
      // Mentores leen sus propias sesiones; directores leen toda la base
      allow read: if isDirector() || (
        isAuthenticated() && (
          resource.data.get('mentor_id', '') == request.auth.uid ||
          resource.data.get('mentorId', '') == request.auth.uid
        )
      );

      // Mentores aprobados pueden crear sesiones en estado 'pending'
      allow create: if isApprovedUser() && (
        request.resource.data.get('mentor_id', '') == request.auth.uid ||
        request.resource.data.get('mentorId', '') == request.auth.uid
      );

      // Los directores tienen permiso para auditar, aprobar (emitir CUV) o rechazar sesiones.
      // Los mentores pueden editar notas antes de la aprobación sin modificar el estado.
      allow update: if isDirector() || (
        isAuthenticated() && (
          resource.data.get('mentor_id', '') == request.auth.uid ||
          resource.data.get('mentorId', '') == request.auth.uid
        ) && (
          resource.data.get('estado', 'pending') == 'pending' ||
          resource.data.get('status', 'pending') == 'pending'
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado', 'status', 'cuv', 'aprobado_por', 'approvedBy'])
      );

      allow delete: if isDirector();
    }

    // ==============================================================
    // 3. COLECCIÓN 'cuvs' (Certificados Públicos Inmutables)
    // ==============================================================
    match /cuvs/{cuvCode} {
      // Lectura 100% pública y abierta para validación O(1) de certificados
      allow read: if true;

      // Creación atómica exclusiva de la dirección académica durante el writeBatch
      allow create: if isDirector();

      // Los certificados emitidos son inmutables
      allow update, delete: if false;
    }
  }
}
