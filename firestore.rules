rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================
    // FUNCIONES AUXILIARES DE SEGURIDAD & AUTENTICACIÓN
    // ==============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPreApprovedEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'carlos.lorzilien@gmail.com' ||
        request.auth.token.email == 'carlosomarlorzilienservilien@gmail.com' ||
        request.auth.token.email == 'carlosmarlorzilienservilien@gmail.com'
      );
    }

    function isDirector() {
      return isAuthenticated() && (
        request.auth.token.email == 'carlos.lorzilien@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['DIRECTOR', 'AREA_DIRECTOR'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('rol', '') in ['DIRECTOR', 'AREA_DIRECTOR']) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'APPROVED')
      );
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        isPreApprovedEmail() ||
        isDirector() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'APPROVED')
      );
    }

    // ==============================================================
    // 1. COLECCIÓN 'users' (Perfiles de Directores, Mentores y Alumnos)
    // ==============================================================
    match /users/{userId} {
      // Lectura pública de perfiles básicos para el Cuadro de Estatus e Impacto institucional
      allow read: if true;

      // Registro inicial del perfil al autenticarse por primera vez
      allow create: if isOwner(userId);

      // El usuario puede actualizar su información básica sin elevar privilegios
      // La Dirección puede actualizar roles y estados (APPROVED/REJECTED/INACTIVE)
      allow update: if isDirector() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'role', 'status'])
      );

      allow delete: if isDirector();
    }

    // ==============================================================
    // 2. COLECCIÓN 'sessions' (Tutorías y Horas Pedagógicas)
    // ==============================================================
    match /sessions/{sessionId} {
      // Lectura pública para el cómputo de métricas y sesiones validadas del programa
      allow read: if true;

      // Mentores aprobados pueden crear sesiones en estado 'pending'
      allow create: if isApprovedUser() && (
        request.resource.data.get('mentor_id', '') == request.auth.uid ||
        request.resource.data.get('mentorId', '') == request.auth.uid
      );

      // Los directores tienen permiso para auditar, aprobar (emitir CUV) o rechazar sesiones.
      // Los mentores pueden editar notas antes de la aprobación sin modificar el estado.
      allow update: if isDirector() || (
        isAuthenticated() && (
          resource.data.get('mentor_id', '') == request.auth.uid ||
          resource.data.get('mentorId', '') == request.auth.uid
        ) && (
          resource.data.get('estado', 'pending') == 'pending' ||
          resource.data.get('status', 'pending') == 'pending'
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado', 'status', 'cuv', 'aprobado_por', 'approvedBy'])
      );

      allow delete: if isDirector();
    }

    // ==============================================================
    // 3. COLECCIÓN 'cuvs' (Certificados Públicos Inmutables)
    // ==============================================================
    match /cuvs/{cuvCode} {
      // Lectura 100% pública y abierta para validación O(1) de certificados
      allow read: if true;

      // Creación atómica exclusiva de la dirección académica durante el writeBatch
      allow create: if isDirector();

      // Los certificados emitidos son inmutables
      allow update, delete: if false;
    }

    // ==============================================================
    // 4. COLECCIÓN 'students' (Alumnos registrados por cada Mentor)
    // ==============================================================
    match /students/{studentId} {
      // Lectura pública de estudiantes para el cálculo de impacto de cohorte en la landing
      allow read: if true;

      // Solo mentores aprobados pueden registrar alumnos, y sólo como suyos
      allow create: if isApprovedUser() &&
        request.resource.data.get('mentorUid', '') == request.auth.uid;

      // El mentor dueño puede actualizar datos del alumno (notas, progreso)
      // pero no puede cambiar el mentorUid ni el uid del alumno
      allow update: if isDirector() || (
        isApprovedUser() &&
        resource.data.get('mentorUid', '') == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mentorUid'])
      );

      allow delete: if isDirector();

      // ── Subcolección 'evaluaciones' (Quizzes y Exámenes Finales) ──
      // Cada evaluación es un registro inmutable que preserva el historial temporal.
      match /evaluaciones/{evalId} {
        // La lectura de evaluaciones requiere autenticación
        allow read: if isAuthenticated();

        // La creación de quizzes sólo está permitida si el usuario está aprobado
        // y es el tutor asignado al alumno o es un Director
        allow create: if isApprovedUser() && (
          isDirector() ||
          get(/databases/$(database)/documents/students/$(studentId)).data.get('mentorUid', '') == request.auth.uid
        );

        // Inmutabilidad estricta: prohíbe explícitamente update y delete
        allow update, delete: if false;
      }
    }
  }
}

