# ==============================================================================
# PRAM OS V1 — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# 1. NEON POSTGRESQL (Base de Datos en la Nube)
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"
POSTGRES_URL="postgresql://usuario:password@host/neondb?sslmode=require"

# 2. CLERK AUTHENTICATION (Opcional - Sistema funciona en Modo Autónomo si faltan)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# 3. SUPABASE (Opcional / Fallback)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
